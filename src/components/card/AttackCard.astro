---
import type { AttackCardData } from '../../types/card';
import { ATTACK_KIND_META } from '../../data/cardCategories';
import { TYPE_META } from '../../lib/pokemonMapping';
import SharedArtwork from './SharedArtwork.astro';
interface Props { card: AttackCardData }
const { card } = Astro.props;
const meta = ATTACK_KIND_META[card.attackKind];
const typeMeta = TYPE_META[card.compatibleType];
const number = String(card.cardNumber).padStart(3, '0');
const kindLabel = meta.label;
const typeIcon = `${import.meta.env.BASE_URL}${typeMeta.icon}`;
---
<article
  class="game-card attack-card trainer-card"
  data-role="card-template"
  data-card-template="attack"
  data-attack-kind={card.attackKind}
  style={`--accent:${meta.accent};--accent-deep:${meta.deep};--attack-surface:${meta.surface};--ribbon-start:${meta.ribbonStart};--ribbon-end:${meta.ribbonEnd};--compat:${typeMeta.color};--compat-deep:${typeMeta.deep};`}
>
  <div class="attack-shell card-shell">
    <header class="tcg-title-rail attack-title-rail">
      <div class="tcg-subtype-ribbon">
        <strong data-role="attack-kind-label">{kindLabel}</strong>
      </div>
      <div class="tcg-major-label">ATAQUE</div>
    </header>

    <div class="tcg-name-row">
      <h2 data-role="attack-name-top">{card.attackName}</h2>
      <span class="tcg-name-glint" aria-hidden="true"></span>
    </div>

    <SharedArtwork artwork={card.artwork} name={card.attackName} />

    <section class="tcg-rules-panel attack-module">
      <div class="compatibility-zone">
        <span class="compatibility-label">COMPATIBILIDADE</span>
        <div class="compatible-pokemon-grid" data-role="compatible-pokemon-grid"></div>
        <div class="compatible-type-display" data-role="compatible-type-display" hidden>
          <span class="compatible-type-symbol">
            <span class="compatible-type-fallback" data-role="compatible-type-symbol">{typeMeta.symbol}</span>
            <img data-role="compatible-type-icon" src={typeIcon} alt="" onerror="this.style.display='none'" />
          </span>
          <strong data-role="compatible-type-text">TODOS OS POKÉMON DE {card.compatibleType.toUpperCase()}</strong>
        </div>
      </div>

      <div class="attack-rule-heading">
        <span>EFEITO</span>
        <h3 data-role="attack-name-bottom">{card.attackName}</h3>
      </div>
      <p class="attack-rule-copy" data-role="attack-description">{card.attackDescription}</p>
    </section>

    <footer class="simple-footer tcg-footer attack-module-footer">
      <span class="set-stamp" data-role="set-code">{card.setCode}</span>
      <span class="collector-number"><strong data-role="card-number">{number}</strong><em>/</em><span data-role="set-total">{card.setTotal}</span></span>
      <span class="edition-mark">CF • 01</span>
    </footer>
  </div>
</article>
