---
import TypeBadge from './TypeBadge.astro';
import type { PokemonCardData } from '../../types/card';
interface Props { card: PokemonCardData }
const { card } = Astro.props;

const modifierPrefix = card.form === 'Mega' ? 'Mega' : '';
const modifierSuffix = card.form === 'Normal' || card.form === 'Mega' ? '' : card.form;
const displayName = [modifierPrefix, card.pokemonName, modifierSuffix].filter(Boolean).join(' ');
const combinedNameLength = displayName.length;
const initialNameSize = combinedNameLength <= 10 ? 33
  : combinedNameLength <= 14 ? 31.5
  : combinedNameLength <= 18 ? 28.5
  : combinedNameLength <= 22 ? 25.5
  : combinedNameLength <= 26 ? 23
  : combinedNameLength <= 32 ? 20.5
  : 18.5;
---
<header class="card-header">
  <div class="evolution-zone" data-role="evolution-zone">
    <span class="stage-pill" data-role="stage">{card.stage}</span>
    <div class:list={['previous-evolution', { 'is-empty': !card.previousEvolution }]} data-role="previous-wrap">
      <span class="previous-medallion">
        <img src={card.previousEvolutionImage} data-role="previous-image" alt={card.previousEvolution ? `Pré-evolução ${card.previousEvolution}` : ''} crossorigin="anonymous" />
      </span>
      <span class="previous-evolution-copy">
        <small>Evolui de</small>
        <strong data-role="previous-name">{card.previousEvolution}</strong>
      </span>
    </div>
  </div>

  <div class="name-zone">
    <h2
      class="pokemon-display-name"
      data-role="pokemon-display-name"
      aria-label={displayName}
      style={`--pokemon-name-size:${initialNameSize}px;`}
    >
      <span class="pokemon-form pokemon-form-prefix" data-role="pokemon-form-prefix">{modifierPrefix}</span>
      <span class="pokemon-name-text" data-role="pokemon-name">{card.pokemonName}</span>
      <span class="pokemon-form pokemon-form-suffix" data-role="pokemon-form-suffix">{modifierSuffix}</span>
    </h2>
  </div>

  <div class="header-stats-zone">
    <div class="header-hp" aria-label={`HP ${card.hp}`}>
      <span>HP</span>
      <strong data-role="stat-hp">{card.hp}</strong>
    </div>
    <div class="type-zone">
      <TypeBadge type={card.type} />
    </div>
  </div>
</header>
