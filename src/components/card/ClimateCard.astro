---
import type { ClimateCardData } from '../../types/card';
import { CARD_CATEGORY_META } from '../../data/cardCategories';
import SharedArtwork from './SharedArtwork.astro';
interface Props { card: ClimateCardData }
const { card } = Astro.props;
const meta = CARD_CATEGORY_META.climate;
const number = String(card.cardNumber).padStart(3, '0');
---
<article
  class="game-card climate-card"
  data-role="card-template"
  data-card-template="climate"
  style={`--accent:${meta.accent};--accent-deep:${meta.deep};--utility-surface:${meta.surface};--ribbon-start:${meta.ribbonStart};--ribbon-end:${meta.ribbonEnd};`}
>
  <div class="climate-shell card-shell">
    <header class="tcg-title-rail climate-title-rail">
      <div class="tcg-subtype-ribbon"><strong>CLIMA</strong></div>
      <div class="tcg-major-label">JORNADA</div>
    </header>
    <div class="tcg-name-row climate-name-row">
      <h2 data-role="climate-name">{card.name}</h2>
      <span class="climate-glyph" aria-hidden="true">☁</span>
    </div>
    <SharedArtwork artwork={card.artwork} name={card.name} />
    <section class="tcg-rules-panel climate-effect">
      <div class="climate-effect-heading"><span aria-hidden="true">✦</span><strong>EFEITO ATMOSFÉRICO</strong><span aria-hidden="true">✦</span></div>
      <div class="tcg-rule-copy"><p data-role="climate-effect">{card.effectText}</p></div>
    </section>
    <footer class="simple-footer tcg-footer">
      <span class="set-stamp" data-role="set-code">{card.setCode}</span>
      <span class="collector-number"><strong data-role="card-number">{number}</strong><em>/</em><span data-role="set-total">{card.setTotal}</span></span>
      <span class="edition-mark">CF • 01</span>
    </footer>
  </div>
</article>
