---
import type { PokemonCardData } from '../../types/card';
interface Props { card: PokemonCardData }
const { card } = Astro.props;
const dex = `#${String(card.pokedexNumber ?? 0).padStart(4, '0')}`;
---
<div class="pokemon-info" aria-label="Informações da espécie">
  <span class="info-pair info-dex"><em>Nº:</em> <strong class="dex-id" data-role="dex-number">{dex}</strong></span>
  <span class="info-pair info-species"><em>Espécie:</em> <span class="species-name" data-role="genus">{card.genus}</span></span>
  <span class="info-pair"><em>Altura:</em> <span data-role="height">{card.height}</span></span>
  <span class="info-pair"><em>Peso:</em> <span data-role="weight">{card.weight}</span></span>
  <span class="info-pair"><em>Região:</em> <span class="region-name" data-role="region">{card.region}</span></span>
</div>
