---
import type { PokemonCardData } from '../../types/card';
interface Props { card: PokemonCardData }
const { card } = Astro.props;
const dex = `#${String(card.pokedexNumber ?? 0).padStart(4, '0')}`;
---
<div class="pokemon-info" aria-label="Informações da espécie">
  <span class="info-item dex-id" data-role="dex-number">{dex}</span>
  <span class="info-item species-name" data-role="genus">{card.genus}</span>
  <span class="info-item info-metric">Altura: <b data-role="height">{card.height}</b></span>
  <span class="info-item info-metric">Peso: <b data-role="weight">{card.weight}</b></span>
  <span class="info-item info-metric region-name">Região: <b data-role="region">{card.region}</b></span>
</div>
