---
import type { PokemonCardData } from '../../types/card';
interface Props { card: PokemonCardData }
const { card } = Astro.props;
const dex = `#${String(card.pokedexNumber ?? 0).padStart(4, '0')}`;
---
<div class="pokemon-info" aria-label="Informações da espécie">
  <span class="info-item dex-id"><b>Nº:</b><i data-role="dex-number">{dex}</i></span>
  <span class="info-item species-name"><b>Vulgo:</b><i data-role="genus">{card.genus}</i></span>
  <span class="info-item"><b>Altura:</b><i data-role="height">{card.height}</i></span>
  <span class="info-item"><b>Peso:</b><i data-role="weight">{card.weight}</i></span>
  <span class="info-item region-name"><b>Região:</b><i data-role="region">{card.region}</i></span>
</div>
