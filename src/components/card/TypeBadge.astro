---
import type { GameType } from '../../types/card';
import { TYPE_META } from '../../lib/pokemonMapping';
interface Props { type: GameType }
const { type } = Astro.props;
const meta = TYPE_META[type];
---
<div class="type-badge" data-role="type-badge" aria-label={`Tipo ${type}`}>
  <span class="type-symbol" data-role="type-symbol" aria-hidden="true">{meta.symbol}</span>
  <span class="type-name" data-role="type-name">{type}</span>
</div>
