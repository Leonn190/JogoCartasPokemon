---
import type { PokemonCardData } from '../../types/card';
interface Props { card: PokemonCardData }
const { card } = Astro.props;
---
<details class="editor-section essential-section" open>
  <summary><span class="section-index">03</span><span><strong>Habilidade</strong><small>Nome principal da habilidade</small></span><i aria-hidden="true">⌄</i></summary>
  <div class="section-body grid-2">
    <div class="field span-2">
      <label for="ability-name">Nome da habilidade</label>
      <input id="ability-name" data-field="abilityName" list="ability-options" value={card.abilityName} maxlength="36" />
      <datalist id="ability-options" data-role="ability-options"></datalist>
      <p class="field-hint">Habilidades da PokéAPI aparecem como sugestões quando disponíveis.</p>
    </div>
  </div>
</details>
