---
import type { CardData } from '../../types/card';
interface Props { card: CardData }
const { card } = Astro.props;
const expanded = card.cardType === 'pokemon' ? card.expandedArtwork : false;
---
<details class="editor-section" open>
  <summary><span class="section-index">ART</span><span><strong>Arte</strong><small>Upload, sugestões, corte, zoom e posição</small></span><i aria-hidden="true">⌄</i></summary>
  <div class="section-body">
    <div class="dropzone" data-role="dropzone" tabindex="0">
      <input class="sr-only" id="artwork-file" data-role="artwork-file" type="file" accept="image/png,image/jpeg,image/webp" />
      <div class="drop-icon" aria-hidden="true">↥</div>
      <strong>Solte sua arte aqui</strong>
      <span>ou clique para escolher PNG, JPG ou WebP</span>
    </div>
    <div class="art-actions">
      <button class="button subtle" type="button" data-action="replace-art">Trocar imagem</button>
      <button class="button subtle danger" type="button" data-action="remove-art">Remover</button>
    </div>

    <div class="tcg-art-panel" data-pokemon-only>
      <div class="tcg-art-copy">
        <strong>Sugestões de artes oficiais</strong>
        <small>Ao carregar um Pokémon pela Pokédex, o editor busca cartas normais em segundo plano. EX, GX, V, Mega e artes especiais são descartadas.</small>
      </div>
      <p class="tcg-art-status" data-role="tcg-art-status">As sugestões serão buscadas automaticamente ao escolher um Pokémon.</p>

      <details class="tcg-suggestions" data-role="tcg-art-suggestions-details">
        <summary>
          <span><strong>Sugestões</strong><small>Clique em uma carta para recortar somente a ilustração</small></span>
          <span class="tcg-suggestion-count" data-role="tcg-art-count">0</span>
        </summary>
        <div class="tcg-suggestions-body">
          <div class="tcg-suggestion-grid" data-role="tcg-art-suggestions">
            <p class="tcg-suggestion-empty">Escolha um Pokémon na busca da Pokédex.</p>
          </div>
          <button class="button subtle tcg-refresh" type="button" data-action="refresh-tcg-art" disabled>Atualizar sugestões</button>
        </div>
      </details>
    </div>

    <div class="range-grid">
      <label class="range-field">
        <span><b>Zoom</b><output data-output="artworkScale">{card.artworkTransform.scale.toFixed(2)}×</output></span>
        <input type="range" min="0.75" max="2.5" step="0.01" value={card.artworkTransform.scale} data-transform="scale" />
      </label>
      <label class="range-field">
        <span><b>Posição X</b><output data-output="artworkX">{card.artworkTransform.x}%</output></span>
        <input type="range" min="-50" max="50" step="1" value={card.artworkTransform.x} data-transform="x" />
      </label>
      <label class="range-field">
        <span><b>Posição Y</b><output data-output="artworkY">{card.artworkTransform.y}%</output></span>
        <input type="range" min="-50" max="50" step="1" value={card.artworkTransform.y} data-transform="y" />
      </label>
    </div>
    <label class="toggle-row" data-pokemon-only>
      <span><strong>Arte Expandida</strong><small>Full Art sem quadro de imagem e sem dados Pokédex</small></span>
      <input class="sr-only" type="checkbox" data-field="expandedArtwork" checked={expanded} />
      <span class="toggle" aria-hidden="true"><i></i></span>
    </label>
    <p class="section-note">Dica: com uma arte carregada, arraste diretamente a imagem no preview para reposicioná-la.</p>
  </div>
</details>
