---
import { GAME_TYPES } from '../../types/card';
import type { AttackCardData } from '../../types/card';
interface Props { card: AttackCardData }
const { card } = Astro.props;
---
<div class="editor-kind" data-editor-kind="attack" hidden>
  <details class="editor-section essential-section" open>
    <summary><span class="section-index">01</span><span><strong>Ataque</strong><small>Nome, tipagem e potência</small></span><i aria-hidden="true">⌄</i></summary>
    <div class="section-body grid-2">
      <div class="field">
        <label for="attack-subtype">Subtipo</label>
        <select id="attack-subtype" data-role="attack-subtype-selector"><option value="normal" selected={card.attackKind === 'normal'}>Ataque Normal</option><option value="special" selected={card.attackKind === 'special'}>Ataque Especial</option></select>
      </div>
      <div class="field span-2">
        <label for="attack-name">Nome do ataque</label>
        <input id="attack-name" data-field="attackName" value={card.attackName} maxlength="32" />
      </div>
      <div class="field">
        <label for="attack-type">Tipo do ataque</label>
        <select id="attack-type" data-field="type">
          {GAME_TYPES.map((type) => <option value={type} selected={type === card.type}>{type}</option>)}
        </select>
        <p class="field-hint">O ícone do tipo aparece na própria carta.</p>
      </div>
      <div class="field span-2">
        <label for="attack-description">Descrição / efeito <span data-role="attack-description-count">{card.attackDescription.length}/360</span></label>
        <textarea id="attack-description" data-field="attackDescription" rows="5" maxlength="360">{card.attackDescription}</textarea>
      </div>
      <div class="field">
        <label for="attack-power">Potência</label>
        <input id="attack-power" data-field="power" type="number" step="1" value={card.power} />
      </div>
    </div>
  </details>

  <details class="editor-section advanced-only-section" open>
    <summary><span class="section-index">02</span><span><strong>Compatibilidade</strong><small>Aparece antes do efeito na carta</small></span><i aria-hidden="true">⌄</i></summary>
    <div class="section-body">
      <div class="segmented-choice" role="radiogroup" aria-label="Modo de compatibilidade">
        <label><input type="radio" name="compatibility-mode" value="specific" data-compat-mode checked={card.compatibilityMode === 'specific'} /><span>Pokémon específicos</span></label>
        <label><input type="radio" name="compatibility-mode" value="type" data-compat-mode checked={card.compatibilityMode === 'type'} /><span>Todos de um tipo</span></label>
      </div>

      <div data-role="specific-compatibility-editor">
        <div class="field search-field attack-search-field">
          <label for="attack-pokemon-search">Adicionar Pokémon <span data-role="compatible-count">0</span></label>
          <div class="search-control" data-role="attack-search-control">
            <span class="search-icon" aria-hidden="true">⌕</span>
            <input id="attack-pokemon-search" data-role="attack-pokemon-search" type="search" autocomplete="off" spellcheck="false" placeholder="Nome ou nº da Pokédex" aria-expanded="false" aria-controls="attack-pokemon-suggestions" />
            <span class="search-spinner" aria-hidden="true"></span>
          </div>
          <div id="attack-pokemon-suggestions" class="suggestions" data-role="attack-pokemon-suggestions" hidden></div>
          <p class="field-hint" data-role="attack-api-status">Sem limite rígido no Avançado. Duplicatas são ignoradas; excessos serão sinalizados na coleção.</p>
        </div>
        <div class="selected-pokemon-list" data-role="selected-pokemon-list"></div>
      </div>

      <div class="field" data-role="type-compatibility-editor" hidden>
        <label for="compatible-type">Tipo compatível</label>
        <select id="compatible-type" data-field="compatibleType">
          {GAME_TYPES.map((type) => <option value={type} selected={type === card.compatibleType}>{type}</option>)}
        </select>
      </div>
    </div>
  </details>

  <details class="editor-section advanced-only-section">
    <summary><span class="section-index">03</span><span><strong>Carta</strong><small>Numeração e coleção</small></span><i aria-hidden="true">⌄</i></summary>
    <div class="section-body grid-2">
      <div class="field"><label for="attack-card-number">Número da carta</label><input id="attack-card-number" data-field="cardNumber" data-derived readonly value={card.cardNumber} /></div>
      <div class="field"><label>Total da coleção</label><input data-role="derived-set-total" value={card.setTotal} readonly /></div>
      <div class="field span-2"><label for="attack-set-code">Sigla da coleção</label><input id="attack-set-code" data-field="setCode" data-derived readonly value={card.setCode} /></div>
    </div>
  </details>
</div>
