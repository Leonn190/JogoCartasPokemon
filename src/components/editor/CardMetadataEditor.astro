---
import { POKEMON_RARITIES, POKEMON_RARITY_LABELS } from '../../types/card';
import type { PokemonCardData } from '../../types/card';
interface Props { card: PokemonCardData }
const { card } = Astro.props;
const raritySymbols = { common: '●', uncommon: '▲', rare: '◆', ultraRare: '★', illustrationRare: '★★', illustrationRareUltra: '★★★' } as const;
---
<details class="editor-section essential-section" open>
  <summary><span class="section-index">05</span><span><strong>Carta</strong><small>Raridade, descrição e metadados da coleção</small></span><i aria-hidden="true">⌄</i></summary>
  <div class="section-body grid-2">
    <div class="field span-2">
      <label for="pokemon-rarity">Raridade</label>
      <select id="pokemon-rarity" data-field="rarity">
        {POKEMON_RARITIES.map((rarity) => <option value={rarity} selected={rarity === card.rarity}>{raritySymbols[rarity]} {POKEMON_RARITY_LABELS[rarity]}</option>)}
      </select>
    </div>
    <div class="field span-2 advanced-only"><label for="flavor-text">Descrição do Pokémon</label><textarea id="flavor-text" data-field="flavorText" rows="4" maxlength="520">{card.flavorText}</textarea></div>
    <div class="field advanced-only"><label>Número da carta</label><input data-field="cardNumber" data-derived readonly value={card.cardNumber} /></div>
    <div class="field advanced-only"><label>Total da coleção</label><input data-role="derived-set-total" readonly value={card.setTotal} /></div>
    <div class="field span-2 advanced-only"><label>Sigla da coleção</label><input data-field="setCode" data-derived readonly value={card.setCode} /></div>
  </div>
</details>
