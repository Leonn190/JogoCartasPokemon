---
import type { PokemonCardData } from '../../types/card';
interface Props { card: PokemonCardData }
const { card } = Astro.props;
---
<details class="editor-section">
  <summary><span class="section-index">07</span><span><strong>Carta</strong><small>Descrição e coleção</small></span><i aria-hidden="true">⌄</i></summary>
  <div class="section-body grid-2">
    <div class="field span-2">
      <label for="flavor-text">Descrição do Pokémon</label>
      <textarea id="flavor-text" data-field="flavorText" rows="4" maxlength="260">{card.flavorText}</textarea>
    </div>
    <div class="field">
      <label for="card-number">Número da carta</label>
      <input id="card-number" data-field="cardNumber" type="number" min="1" max="150" value={card.cardNumber} />
    </div>
    <div class="field">
      <label>Total da coleção</label>
      <input value="150" readonly aria-readonly="true" />
    </div>
    <div class="field span-2">
      <label for="set-code">Sigla da coleção</label>
      <input id="set-code" data-field="setCode" value={card.setCode} maxlength="8" spellcheck="false" />
    </div>
  </div>
</details>
