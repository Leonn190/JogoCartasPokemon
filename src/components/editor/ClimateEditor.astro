---
import type { ClimateCardData } from '../../types/card';
interface Props { card: ClimateCardData }
const { card } = Astro.props;
---
<div class="editor-kind" data-editor-kind="climate" hidden>
  <div class="editor-mode-heading">
    <span class="eyebrow">ESSENCIAL</span>
    <h2>Clima</h2>
    <p>Nome, efeito e arte. A coleção controla a numeração automaticamente.</p>
  </div>
  <details class="editor-section" open>
    <summary><span class="section-index">01</span><span><strong>Conteúdo</strong><small>Identidade e efeito persistente</small></span><i aria-hidden="true">⌄</i></summary>
    <div class="section-body grid-2">
      <div class="field span-2"><label for="climate-name">Nome</label><input id="climate-name" data-field="name" value={card.name} maxlength="34" /></div>
      <div class="field span-2"><label for="climate-effect">Texto de efeito</label><textarea id="climate-effect" data-field="effectText" rows="6" maxlength="460">{card.effectText}</textarea></div>
    </div>
  </details>
</div>
