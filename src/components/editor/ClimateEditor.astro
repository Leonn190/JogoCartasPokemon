---
import type { ClimateCardData } from '../../types/card';
interface Props { card: ClimateCardData }
const { card } = Astro.props;
---
<div class="editor-kind" data-editor-kind="climate" hidden>
  <details class="editor-section essential-section" open>
    <summary><span class="section-index">01</span><span><strong>Clima</strong><small>Nome e efeito global</small></span><i aria-hidden="true">⌄</i></summary>
    <div class="section-body grid-2">
      <div class="field span-2"><label for="climate-name">Nome</label><input id="climate-name" data-field="name" value={card.name} maxlength="34" /></div>
      <div class="field span-2"><label for="climate-effect">Efeito</label><textarea id="climate-effect" data-field="effectText" rows="6" maxlength="430">{card.effectText}</textarea></div>
    </div>
  </details>
  <details class="editor-section advanced-only-section">
    <summary><span class="section-index">ADV</span><span><strong>Avançado</strong><small>Metadados derivados da coleção</small></span><i aria-hidden="true">⌄</i></summary>
    <div class="section-body grid-2">
      <div class="field"><label>Número da carta</label><input data-field="cardNumber" data-derived readonly value={card.cardNumber} /></div>
      <div class="field"><label>Total da coleção</label><input data-role="derived-set-total" readonly value={card.setTotal} /></div>
      <div class="field span-2"><label>Sigla da coleção</label><input data-field="setCode" data-derived readonly value={card.setCode} /></div>
    </div>
  </details>
</div>
