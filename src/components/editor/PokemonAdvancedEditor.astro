---
import { GAME_TYPES, POKEMON_RARITIES, POKEMON_RARITY_LABELS } from '../../types/card';
import type { PokemonCardData } from '../../types/card';
interface Props { card: PokemonCardData }
const { card } = Astro.props;
const raritySymbols = { common: '●', uncommon: '▲', rare: '◆', ultraRare: '★', illustrationRare: '★★', illustrationRareUltra: '★★★' } as const;
---
<details class="editor-section">
  <summary><span class="section-index">A1</span><span><strong>Ajustes finos</strong><small>Raridade, tipo manual e texto da habilidade</small></span><i aria-hidden="true">⌄</i></summary>
  <div class="section-body grid-2">
    <div class="field">
      <label for="pokemon-rarity">Raridade</label>
      <select id="pokemon-rarity" data-field="rarity">
        {POKEMON_RARITIES.map((rarity) => <option value={rarity} selected={rarity === card.rarity}>{raritySymbols[rarity]} {POKEMON_RARITY_LABELS[rarity]}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="pokemon-type-advanced">Override de tipo</label>
      <select id="pokemon-type-advanced" data-field="type">
        {GAME_TYPES.map((type) => <option value={type} selected={type === card.type}>{type}</option>)}
      </select>
    </div>
    <div class="field span-2">
      <label for="ability-description">Descrição / efeito da habilidade</label>
      <textarea id="ability-description" data-field="abilityDescription" rows="4" maxlength="260">{card.abilityDescription}</textarea>
    </div>
  </div>
</details>
