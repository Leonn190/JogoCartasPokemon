---
import PokemonSearch from './PokemonSearch.astro';
import { GAME_TYPES, CARD_FORMS } from '../../types/card';
import type { PokemonCardData } from '../../types/card';
interface Props { card: PokemonCardData }
const { card } = Astro.props;
---
<details class="editor-section essential-section" open>
  <summary><span class="section-index">01</span><span><strong>Pokémon</strong><small>Busca, identidade, forma e tipo</small></span><i aria-hidden="true">⌄</i></summary>
  <div class="section-body grid-2">
    <PokemonSearch />
    <div class="field span-2">
      <label for="pokemon-name">Nome</label>
      <input id="pokemon-name" data-field="pokemonName" value={card.pokemonName} maxlength="28" />
    </div>
    <div class="field">
      <label for="pokemon-form">Forma</label>
      <select id="pokemon-form" data-field="form" data-role="pokemon-subtype-selector">
        {CARD_FORMS.map((form) => <option value={form} selected={form === card.form}>{form}</option>)}
      </select>
    </div>
    <div class="field pokemon-type-field">
      <label for="pokemon-type">Tipo do jogo</label>
      <div class="type-candidate-row essential-type-buttons" data-role="type-candidates"></div>
      <select id="pokemon-type" class="advanced-type-select" data-field="type">
        {GAME_TYPES.map((type) => <option value={type} selected={type === card.type}>{type}</option>)}
      </select>
      <p class="field-hint" data-role="type-suggestion">No Essencial aparecem só os tipos sugeridos pela PokéAPI. No Avançado, todos ficam disponíveis.</p>
    </div>
  </div>
</details>
