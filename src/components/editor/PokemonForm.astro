---
import PokemonSearch from './PokemonSearch.astro';
import { GAME_TYPES, POKEMON_RARITIES, POKEMON_RARITY_LABELS } from '../../types/card';
import type { PokemonCardData } from '../../types/card';
interface Props { card: PokemonCardData }
const { card } = Astro.props;
const raritySymbols = {
  common: '●', uncommon: '▲', rare: '◆', ultraRare: '★', illustrationRare: '★★', illustrationRareUltra: '★★★',
} as const;
---
<details class="editor-section" open>
  <summary><span class="section-index">01</span><span><strong>Pokémon</strong><small>Identidade, tipo e raridade</small></span><i aria-hidden="true">⌄</i></summary>
  <div class="section-body grid-2">
    <PokemonSearch />
    <div class="field span-2">
      <label for="pokemon-name">Nome</label>
      <input id="pokemon-name" data-field="pokemonName" value={card.pokemonName} maxlength="28" />
    </div>
    <div class="field">
      <label for="pokemon-type">Tipo do jogo</label>
      <select id="pokemon-type" data-field="type">
        {GAME_TYPES.map((type) => <option value={type} selected={type === card.type}>{type}</option>)}
      </select>
      <p class="field-hint" data-role="type-suggestion"></p>
    </div>
    <div class="field">
      <label for="pokemon-rarity">Raridade</label>
      <select id="pokemon-rarity" data-field="rarity">
        {POKEMON_RARITIES.map((rarity) => <option value={rarity} selected={rarity === card.rarity}>{raritySymbols[rarity]} {POKEMON_RARITY_LABELS[rarity]}</option>)}
      </select>
      <p class="field-hint">● comum • ▲ incomum • ◆ raro • ★ ultra raro • ★★ ilustração rara normal • ★★★ ilustração rara especial</p>
    </div>
  </div>
</details>
