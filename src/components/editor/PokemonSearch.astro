<div class="field span-2 search-field">
  <label for="pokemon-search">Pokémon — PokéAPI</label>
  <div class="search-control" data-role="search-control">
    <span class="search-icon" aria-hidden="true">⌕</span>
    <input id="pokemon-search" data-role="pokemon-search" type="search" autocomplete="off" spellcheck="false" placeholder="Nome ou nº da Pokédex" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="pokemon-suggestions" />
    <span class="search-spinner" data-role="search-spinner" aria-hidden="true"></span>
  </div>
  <div id="pokemon-suggestions" class="suggestions" data-role="pokemon-suggestions" role="listbox" hidden></div>
  <p class="field-hint" data-role="api-status">Digite pelo menos 2 letras ou um número e selecione uma sugestão.</p>
</div>
