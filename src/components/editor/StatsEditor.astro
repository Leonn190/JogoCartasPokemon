---
import type { PokemonCardData } from '../../types/card';
interface Props { card: PokemonCardData }
const { card } = Astro.props;
const stats = [
  ['HP', 'hp', card.hp, 'hp', 30], ['ATK', 'attack', card.attack, 'attack', null], ['DEF', 'defense', card.defense, 'defense', null],
  ['SPA', 'specialAttack', card.specialAttack, 'specialAttack', null], ['SPD', 'specialDefense', card.specialDefense, 'specialDefense', null], ['VEL', 'speed', card.speed, 'speed', null],
] as const;
---
<details class="editor-section essential-section" open>
  <summary><span class="section-index">02</span><span><strong>Status</strong><small>Digite 1 para 10, 2 para 20, 20 para 200</small></span><i aria-hidden="true">⌄</i></summary>
  <div class="section-body">
    <div class="stats-editor-grid">
      {stats.map(([label, field, value, ref, max]) => (
        <label class="stat-input">
          <span>{label}</span>
          <input type="number" min="0" max={max ?? undefined} step="1" inputmode="numeric" value={Math.round(value / 10)} data-field={field} data-stat-scale="10" data-essential-max={max ?? undefined} />
          <small>Base API arredondada: <b data-reference-stat={ref}>—</b></small>
        </label>
      ))}
    </div>
    <button class="button subtle full" type="button" data-action="use-official-stats" disabled>Usar valores arredondados da PokéAPI</button>
    <p class="section-note">O número digitado é multiplicado por 10 na carta. Ex.: 7 → 70.</p>
  </div>
</details>
