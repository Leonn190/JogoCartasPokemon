---
import type { UtilityCardData } from '../../types/card';
interface Props { card: UtilityCardData }
const { card } = Astro.props;
---
<div class="editor-kind" data-editor-kind="utility" hidden>
  <details class="editor-section" open>
    <summary><span class="section-index">01</span><span><strong>Conteúdo</strong><small>Nome, efeito e instrução editável</small></span><i aria-hidden="true">⌄</i></summary>
    <div class="section-body grid-2">
      <div class="field span-2"><label for="utility-name">Nome</label><input id="utility-name" data-field="name" value={card.name} maxlength="34" /></div>
      <div class="field span-2"><label for="utility-effect">Texto / efeito</label><textarea id="utility-effect" data-field="effectText" rows="5" maxlength="430">{card.effectText}</textarea></div>
      <div class="field span-2"><label for="utility-usage">Como usar</label><textarea id="utility-usage" data-field="usageText" rows="4" maxlength="300">{card.usageText}</textarea><p class="field-hint">Este campo é totalmente editável; nenhuma regra de uso é fixada pelo editor.</p></div>
    </div>
  </details>
  <details class="editor-section">
    <summary><span class="section-index">02</span><span><strong>Carta</strong><small>Numeração e coleção</small></span><i aria-hidden="true">⌄</i></summary>
    <div class="section-body grid-2">
      <div class="field"><label for="utility-card-number">Número da carta</label><input id="utility-card-number" data-field="cardNumber" type="number" min="1" max="150" value={card.cardNumber} /></div>
      <div class="field"><label>Total da coleção</label><input value="150" readonly /></div>
      <div class="field span-2"><label for="utility-set-code">Sigla da coleção</label><input id="utility-set-code" data-field="setCode" value={card.setCode} maxlength="8" spellcheck="false" /></div>
    </div>
  </details>
</div>
