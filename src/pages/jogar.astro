---
import '../styles/global.css';
import '../styles/game.css';
import { join } from 'node:path';
import { loadPublishedCollections } from '../lib/publishedContent';

const contentDirectory = join(process.cwd(), 'public', 'conteudo');
const publishedCollections = loadPublishedCollections(contentDirectory, import.meta.env.BASE_URL);
const publishedCollectionsJson = JSON.stringify(publishedCollections).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="pt-BR" data-base-url={import.meta.env.BASE_URL}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101311" />
    <meta name="description" content="Simulador local de Jornada para 4 jogadores em modo jogue-e-passe." />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>Card Forge / Jornada — Jogar</title>
  </head>
  <body class="journey-body">
    <div data-role="game-root"></div>
    <script is:inline id="published-collections" type="application/json" set:html={publishedCollectionsJson}></script>
    <script src="../scripts/game.ts"></script>
  </body>
</html>
